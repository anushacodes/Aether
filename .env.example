# Optional shell environment overrides; this file is not loaded automatically.
# Use AWS's normal credential chain or a named profile. Never put keys in this file.
RAG_AWS_REGION=us-east-1
RAG_AWS_PROFILE=
RAG_ARTIFACT_BUCKET=
RAG_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_EMBEDDING_DIMENSIONS=1024
RAG_GENERATION_MODEL_ID=
# Deliberately unset: choose an allowance before any paid calls.
RAG_DEVELOPMENT_MODEL_BUDGET_USD=
RAG_OPENSEARCH_URL=http://localhost:9200
RAG_SEARCH_INDEX=s3-rag-active
# Optional server-only administrator token. Unset disables all ingestion HTTP endpoints.
# Generate your own long random value; never use NEXT_PUBLIC_ for this secret.
RAG_ADMIN_TOKEN=
# JSON array of permitted browser origins; no wildcard is added implicitly.
RAG_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
