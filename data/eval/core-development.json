      "permitted_guides": [
        "s3-api"
      ],
      "source_scope": "general-purpose",
      "reference_answer": "A response returns at most 1,000 parts. If IsTruncated is true, use its NextPartNumberMarker value as the part-number-marker query parameter in the next ListParts request.",
