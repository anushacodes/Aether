    {
      "question_id": "core-006",
      "query": "Does an HTTP 200 OK header from CompleteMultipartUpload always mean the upload completed successfully?",
      "category": "troubleshooting",
      "permitted_guides": [
        "s3-api"
      ],
      "source_scope": "general-purpose",
      "reference_answer": "No. Processing can fail after the initial 200 OK header, and an error can be embedded in that response. A direct API client must parse the response body and handle the result.",
