      "question_id": "core-014",
      "query": "How does GET respond when the current version is a delete marker, compared with a GET explicitly requesting the delete marker’s version ID?",
      "category": "comparison",
      "permitted_guides": [
        "s3-userguide"
      ],
      "source_scope": "general-purpose",
      "reference_answer": "Without versionId and with a current delete marker, S3 returns 404 and x-amz-delete-marker: true. When versionId identifies a delete marker, S3 returns 405, that header, and Last-Modified for GetObject or HeadObject.",
      "reference_passage_ids": [
        "delete-marker-current-get",
        "delete-marker-version-get"
      ],
      "expected_answerability": "answerable",
