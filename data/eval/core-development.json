      "question_id": "core-001",
      "query": "One part of my multipart upload failed in transit. Do I need to restart the whole object upload?",
      "category": "troubleshooting",
      "permitted_guides": [
        "s3-userguide",
        "s3-api"
      ],
      "source_scope": "general-purpose",
      "reference_answer": "No. Retransmit the failed part; this does not affect other uploaded parts. S3 assembles the object after all parts are uploaded.",
      "reference_passage_ids": [
        "multipart-retry"
      ],
      "expected_answerability": "answerable",
      "split": "development",
      "group_id": "core-evidence-001",
