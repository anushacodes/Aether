      "question_id": "core-013",
      "query": "Does changing an existing object’s tags create a new version in a versioning-enabled bucket?",
      "category": "direct_fact",
      "permitted_guides": [
        "s3-userguide"
      ],
      "source_scope": "general-purpose",
      "reference_answer": "No. Changing tags does not PUT a new object, so it does not create a new object version. Operations such as CopyObject can create versions because they implement a PUT.",
